# ChromaDB API Service Environment Variables

# ChromaDB Server Configuration (where ChromaDB is running)
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_HTTP_PORT=8000

# API Service Configuration (this service)
API_HOST=0.0.0.0
API_PORT=8001

# For production deployment:
# CHROMA_SERVER_HOST=your-chromadb-server.com
# CHROMA_SERVER_HTTP_PORT=8000
# API_HOST=0.0.0.0
# API_PORT=8001
